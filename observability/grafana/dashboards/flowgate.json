{
  "uid": "flowgate",
  "title": "Flowgate",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Proxy requests / sec",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flowgate_proxy_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "custom": {} }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rate-limit rejects / sec",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flowgate_ratelimit_rejected_total[1m]))",
          "legendFormat": "rejected"
        }
      ],
      "fieldConfig": { "defaults": { "custom": {} }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Proxy cache hit vs miss / sec",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flowgate_proxy_requests_total[1m])) by (cache)",
          "legendFormat": "{{cache}}"
        }
      ],
      "fieldConfig": { "defaults": { "custom": {} }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM heap used",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": {} }, "overrides": [] }
    }
  ]
}
